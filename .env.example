# Milvus Configuration (using Milvus Lite)
COLLECTION_NAME=pdf_chunks

# LLM Configuration (vLLM)
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=meta-llama/Llama-2-7b-hf

# Embedding Model
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-s

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Retrieval Configuration
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Hugging Face Token (for downloading Llama model)
# Get your token from: https://huggingface.co/settings/tokens
# Must have read permissions for meta-llama/Llama-2-7b-hf
HUGGING_FACE_HUB_TOKEN="hf_your_token_here"
